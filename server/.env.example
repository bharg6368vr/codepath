# All variables are optional — the app runs fully without any of them,
# using local fallbacks (file-based storage, local compilers, mock quiz data).

PORT=4000

# Signs auth JWTs. Falls back to an insecure dev default if unset — set a
# real secret before deploying anywhere but your own machine.
JWT_SECRET=

# Where the Flask RAG service is running (see rag-service/.env.example).
RAG_SERVICE_URL=http://localhost:5001

# Minimum quiz score (0-100) required to pass and unlock a certificate.
QUIZ_PASS_THRESHOLD=70

# Public URL of the client app, used to build the full certificate
# verification address (both in the API response and on the PDF itself).
# Set this to your real deployed URL in production.
PUBLIC_APP_URL=http://localhost:5173

# If unset, the Coding Workspace/"try it yourself" editor executes code
# locally via each language's installed toolchain (python3/gcc/g++/javac+java)
# instead of Judge0. Set these to use Judge0 CE (self-hosted or RapidAPI) instead.
JUDGE0_API_URL=
JUDGE0_API_KEY=
