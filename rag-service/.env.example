# Optional. Without this, quiz generation and answer evaluation fall back to
# a deterministic mock (still real retrieval, just no LLM call) so the app
# works end-to-end with zero paid services.
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-opus-5
RAG_SERVICE_PORT=5001

# Required for the "Ask a doubt" student chatbot (theory/code/error questions).
# Get one at https://aistudio.google.com/apikey. There is no mock fallback for
# this feature — without a key, the chat widget shows a clear "not configured"
# error instead of a fake reply.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
